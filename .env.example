# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=example


# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=


# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"


# ─── OAuth providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── Media storage (local Hostinger disk) ────────────────────────────────────────
MEDIA_UPLOAD_DIR=
MEDIA_REMOTE_ROOT=
NEXT_PUBLIC_MEDIA_BASE_URL=

# Max size accepted by the upload route, in megabytes.
MEDIA_MAX_UPLOAD_MB=500


# ─── SFTP (dev machine => Hostinger media sync) ────────────────────────────────
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSPHRASE=


# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
