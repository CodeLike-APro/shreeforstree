    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "razorpay": "^2.9.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.10.0",
    "sharp": "0.32.6",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.4.3",
